# Environment
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dentalflow

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=yoursecretkeyhere
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — set to your frontend URL in production
ALLOWED_ORIGINS=*

# Email (optional — reminders will log warnings if not set)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
CLINIC_EMAIL=notifications@dentist.com

# Simulator (set to false in production)
SIMULATOR_ENABLED=true

# AI — Google Gemini (FREE — get key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key-here

# AI — OpenAI (paid fallback — optional)
OPENAI_API_KEY=

# Meta Platform — Facebook + Instagram
META_VERIFY_TOKEN=your-random-verify-token
META_APP_SECRET=your-meta-app-secret
META_PAGE_ACCESS_TOKEN=your-page-access-token
META_APP_ID=your-meta-app-id

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token

# Sentry error tracking (optional — get from https://sentry.io)
SENTRY_DSN=
